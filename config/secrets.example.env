# Copy to %USERPROFILE%\.cryptobot\secrets.env (OUTSIDE the repo and OUTSIDE OneDrive).
# Override the location with CRYPTOBOT_SECRETS_FILE. Real environment variables win over this file.

# Kalshi margin (perps) API keys. These are separate from event-contract keys.
# The private key is a path to a PEM file (RSA or Ed25519), never the key itself.
# "~/..." works on both macOS and Windows, so this file can move between machines unchanged.
KALSHI_PROD_KEY_ID=
KALSHI_PROD_PRIVATE_KEY_PATH=~/.cryptobot/kalshi-prod.pem
KALSHI_DEMO_KEY_ID=
KALSHI_DEMO_PRIVATE_KEY_PATH=

# Robinhood Crypto Trading API (official). Private key is the base64 Ed25519 seed.
ROBINHOOD_API_KEY=
ROBINHOOD_PRIVATE_KEY_B64=
# Required for v2 (fee-tier) endpoints such as holdings/orders; not needed for quotes.
ROBINHOOD_ACCOUNT_NUMBER=

# Optional: phone alerts via ntfy.sh (pick an unguessable topic name).
NTFY_TOPIC=
