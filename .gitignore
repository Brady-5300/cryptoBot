# Secrets: never commit. Real secrets live in %USERPROFILE%\.cryptobot\secrets.env
.env
*.env
*.pem
*.key
secrets*
# The template has no values and must be committed (after the rules above so it wins).
!config/secrets.example.env

# Data lives outside the repo (CRYPTOBOT_DATA_DIR); guard against accidents.
# Leading slash: only a top-level data/ folder, NOT the src/basis/data/ package.
/data/
*.parquet
*.jsonl
*.jsonl.zst
*.duckdb

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
*.egg-info/
dist/
build/

# Notebooks
.ipynb_checkpoints/
